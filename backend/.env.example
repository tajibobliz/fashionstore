# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=fashionstore
DATABASE_SSL=false

# JWT (autenticación)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Aplicación
PORT=3000
NODE_ENV=development
APP_TIMEZONE=America/La_Paz

ANTHROPIC_API_KEY=
# Reportes con IA (Fase 3): anthropic (Claude, requiere API key) o simulado (reglas, sin internet)
LLM_PROVIDER=anthropic
AI_REPORTS_MODEL=claude-haiku-4-5
AI_REPORTS_MAX_ITER=4
AI_REPORTS_MAX_TOKENS=1024
AI_REPORTS_POR_MINUTO=10
# Analítica con ML (Fase 3): microservicio FastAPI en ml-service/ (misma clave en ambos lados)
ML_SERVICE_URL=http://localhost:8001
ML_API_KEY=dev-ml-key
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@fashionstore.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
ADMIN_LAST_NAME=Sistema
