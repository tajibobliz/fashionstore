# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=fashionstore
DATABASE_SSL=false

# JWT (autenticación)
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Aplicación
PORT=3000
NODE_ENV=development
APP_TIMEZONE=America/La_Paz

ANTHROPIC_API_KEY=
# Reportes con IA (Fase 3): anthropic (Claude, requiere API key) o simulado (reglas, sin internet)
LLM_PROVIDER=anthropic
AI_REPORTS_MODEL=claude-haiku-4-5
AI_REPORTS_MAX_ITER=4
AI_REPORTS_MAX_TOKENS=1024
AI_REPORTS_POR_MINUTO=10
# Analítica con ML (Fase 3): microservicio FastAPI en ml-service/ (misma clave en ambos lados)
ML_SERVICE_URL=http://localhost:8001
ML_API_KEY=dev-ml-key
# Reentrenamiento automático (cron, hora de APP_TIMEZONE). off = desactivado
ML_CRON=0 3 * * *
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@fashionstore.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
ADMIN_LAST_NAME=Sistema

# --- Pago de la suscripción (planes en USD) con Stripe Checkout ---
# Claves de PRUEBA del panel de Stripe (Developers → API keys). Sin STRIPE_SECRET_KEY se usa
# una pasarela simulada (pantalla de pago propia, sin cobro).
STRIPE_SECRET_KEY=
# La muestra `stripe listen --forward-to localhost:3000/billing/stripe/webhook` (whsec_...).
STRIPE_WEBHOOK_SECRET=
# A dónde vuelve el usuario después de pagar (el frontend).
APP_URL=http://localhost:5173
# simulado = forzar la pasarela simulada aunque haya claves (las pruebas automáticas lo hacen solas).
BILLING_PROVIDER=
