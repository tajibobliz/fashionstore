{
  "expo": {
    "name": "FashionStore",
    "slug": "mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "El vestidor virtual usa la cámara frontal para mostrarte la prenda puesta. La imagen no se guarda ni se envía."
      }
    },
    "android": {
      "package": "com.henry.fashionstore",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "permissions": ["CAMERA", "INTERNET", "POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para subir el comprobante de pago de tus pedidos.",
          "cameraPermission": "El vestidor virtual usa la cámara frontal para mostrarte la prenda puesta. La imagen no se guarda ni se envía.",
          "microphonePermission": false
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08c4969d-1797-451b-b212-e4888f5ad303"
      }
    },
    "owner": "heidajaz"
  }
}
